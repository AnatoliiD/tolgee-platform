# Multi-stage Dockerfile that builds the application from source.
# Used by the dockerFromSource / dockerFromSourceOss gradle tasks (see gradle/docker.gradle).
# Requires BuildKit, which picks up Dockerfile.build.dockerignore automatically.

FROM eclipse-temurin:25-jdk AS jdk

#############
### Build stage - Java/Kotlin backend
#############
# The backend build also exports the email templates via npm, so it needs both Node and the JDK.
FROM node:22-bookworm-slim AS backend-builder

COPY --from=jdk /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk \
    PATH="/opt/java/openjdk/bin:${PATH}"

WORKDIR /app

# Copy gradle wrapper and build files first to cache the gradle distribution
COPY gradlew gradlew.bat gradle.properties settings.gradle build.gradle ./
COPY gradle/ gradle/
RUN chmod +x ./gradlew && ./gradlew --version --no-daemon

COPY . /app/

ARG VERSION=local
ENV VERSION=${VERSION}

RUN SKIP_WEBAPP_BUILD=true ./gradlew :server-app:bootJar --no-daemon --stacktrace

# Extract the JAR immediately after building
RUN cd /app/backend/app/build/libs && \
    jar -xf *.jar && \
    rm *.jar && \
    echo -n "${VERSION}" > BOOT-INF/classes/.VERSION

#############
### Build stage - Node.js frontend
#############
FROM node:22-alpine AS frontend-builder

RUN apk add --no-cache bash git

WORKDIR /app
COPY . /app/

WORKDIR /app/library
RUN npm ci

# npm ci runs the "prepare" script too, but run it explicitly so the ee/oss module
# symlink always matches the sources in the build context
WORKDIR /app/webapp
RUN npm ci
RUN npm run prepare
RUN npm run build

#############
### Runtime stage (same base as Dockerfile.slim - no embedded postgres)
#############
FROM eclipse-temurin:25-jre-alpine

RUN apk --no-cache add bash

#############
### Tolgee  #
#############

# Expose application port
EXPOSE 8080

# Define persistent volume for data storage
VOLUME /data

# Environment variables for configuration
# Postgres autostart is disabled — the image doesn't bundle the postgres
# server, so it must be run against an external database.
ENV HEALTHCHECK_PORT=8080 \
    spring_profiles_active=docker \
    TOLGEE_POSTGRES_AUTOSTART_ENABLED=false

# Copy extracted JAR contents to app directory
COPY --from=backend-builder /app/backend/app/build/libs/BOOT-INF/lib /app/lib
COPY --from=backend-builder /app/backend/app/build/libs/META-INF /app/META-INF
COPY --from=backend-builder /app/backend/app/build/libs/BOOT-INF/classes /app

# Copy built webapp to the correct location (overwriting any existing static files)
COPY --from=frontend-builder /app/webapp/dist /app/static

# Copy startup script
COPY --chmod=755 docker/app/cmd.sh /app

# Download OpenTelemetry Java agent for distributed tracing
# When OTEL_JAVAAGENT_ENABLED=true, cmd.sh will use this agent
# Version is passed from gradle.properties via --build-arg (see gradle/docker.gradle)
ARG OTEL_AGENT_VERSION
RUN test -n "$OTEL_AGENT_VERSION" || (echo "OTEL_AGENT_VERSION build arg is required" && exit 1)
RUN wget -O /app/opentelemetry-javaagent.jar \
    "https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v${OTEL_AGENT_VERSION}/opentelemetry-javaagent.jar"

#################
### Let's go   ##
#################

# Define the startup command
ENTRYPOINT ["/app/cmd.sh"]

# Health check to ensure the app is up and running
HEALTHCHECK --interval=10s --timeout=3s --retries=20 \
    CMD wget --spider -q "http://127.0.0.1:$HEALTHCHECK_PORT/actuator/health" || exit 1
